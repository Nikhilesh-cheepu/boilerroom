# Copy to `.env.local` and set the same on your host (Vercel / Railway).

# --- Database (PostgreSQL) ---
# Keep BOTH for Railway-style setups:
# - `DATABASE_PUBLIC_URL`: public proxy URL (useful from local laptop/dev).
# - `DATABASE_URL`: primary URL (often internal host in production).
# Runtime code auto-picks the right one.
DATABASE_PUBLIC_URL="postgresql://USER:PASSWORD@PUBLIC-HOST:PORT/DATABASE"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
# If deploy logs show missing `GalleryImage`: from a machine with DB access run `npm run db:push`, or execute `prisma/manual/add_gallery_image.sql` once in Postgres.

# --- Admin (password-only login is fine; session signing uses this or ADMIN_SESSION_SECRET below) ---
ADMIN_PASSWORD="9550"
# Optional: if set (16+ chars), used to sign admin cookies instead of deriving from ADMIN_PASSWORD.
# ADMIN_SESSION_SECRET="long-random-string"

# --- Media (Vercel Blob) — hero video uploads in /admin/settings ---
# Create a token in Vercel → Storage → Blob → create Read/Write token.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# --- Bassik lineup API (server-only) ---
EVENTS_API_BASE_URL=https://bassik.in
# Optional alias (same meaning as EVENTS_API_BASE_URL):
# BASSIK_EVENTS_API_BASE_URL=https://bassik.in
EVENTS_API_FETCH_TIMEOUT_MS=4000

# --- Public (browser) ---
# Defaults for the sticky bar + contact sheet. Override per-venue in Admin → Settings
# (stored on SiteSettings); leave admin fields empty to keep using these.
NEXT_PUBLIC_PHONE_E164=15551234567
NEXT_PUBLIC_WHATSAPP_MESSAGE_BOOKING=Hi Boiler Room — I'd like to book a table. Date / guests:
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/yourvenue
NEXT_PUBLIC_MAPS_URL=https://www.google.com/maps/search/?api=1&query=Your+Venue+Address
NEXT_PUBLIC_ADDRESS_LINE=Your address — City

# --- Table booking (/book) + Interakt (https://api.interakt.ai/v1/public/message/) ---
# Correct prefix: INTERAKT (Interakt = I N T E R A K T). Typos INTERACT_ / INTRAKT_ are read as fallbacks.
# Usually Interakt gives a Base64 credential — paste it as INTERAKT_API_KEY (we send Basic <value>).
# Or set the full header: INTERAKT_AUTHORIZATION="Basic …"
INTERAKT_API_KEY=
INTERAKT_BOOKING_TEMPLATE_NAME=bassik_website
INTERAKT_BOOKING_TEMPLATE_LANGUAGE_CODE=en
# Staff table copy (optional; same nine placeholders as guest table template).
INTERAKT_STAFF_BOOKING_TEMPLATE_NAME=bassik_website_outlet
INTERAKT_STAFF_BOOKING_TEMPLATE_LANGUAGE_CODE=en
INTERAKT_STAFF_NOTIFY_PHONE=
# Event templates (when you add event booking; table flow ignores these today).
INTERAKT_EVENT_TEMPLATE_NAME=bassik_website_events
INTERAKT_EVENT_TEMPLATE_LANGUAGE_CODE=en
INTERAKT_STAFF_EVENT_TEMPLATE_NAME=bassik_events_outlet
# Optional override for staff event template language (else EVENT language).
# INTERAKT_STAFF_EVENT_TEMPLATE_LANGUAGE_CODE=en
# Local dev without Interakt: set to true to save reservations but skip WhatsApp.
# BOOKING_SKIP_INTERAKT=true
