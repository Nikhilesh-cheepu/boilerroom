# Copy to `.env.local` (and ensure these are set in your host for production).

# SQLite (local). For serverless hosting, switch to Postgres and update `prisma/schema.prisma`.
DATABASE_URL="file:./prisma/dev.db"

# Admin login (plain password — keep private; use a strong value).
ADMIN_PASSWORD="change-me-please-8chars-min"

# Signs admin session cookies (min 16 characters).
ADMIN_SESSION_SECRET="change-me-to-a-long-random-string"

# Public site configuration (safe to expose to the browser — inlined at build time).

# E.164 digits only, no + (e.g. US: 14155552671). Used for tel: and wa.me links.
NEXT_PUBLIC_PHONE_E164=15551234567

# Prefilled WhatsApp message when tapping "Book a table".
NEXT_PUBLIC_WHATSAPP_MESSAGE_BOOKING=Hi Boiler Room — I'd like to book a table. Date / guests:

NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/yourvenue

# Google Maps / Apple Maps link for "Location" and the location teaser CTA.
NEXT_PUBLIC_MAPS_URL=https://www.google.com/maps/search/?api=1&query=Your+Venue+Address

# Single-line address shown in the UI and contact sheet.
NEXT_PUBLIC_ADDRESS_LINE=Your address — City
