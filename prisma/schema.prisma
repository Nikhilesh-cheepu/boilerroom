generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SiteSettings {
  id            Int      @id @default(1)
  tagline       String
  heroSub       String
  /// HTTPS URL for hero video (e.g. Vercel Blob) or legacy /uploads/... path
  heroVideoPath String?
  /// E.164 digits (country code, no +) for tel: — editable in /admin/settings
  contactPhoneE164       String?
  /// WhatsApp number for wa.me (digits only); falls back to phone if empty
  contactWhatsappE164  String?
  contactPhoneDisplay  String?
  contactWhatsappDisplay String?
  contactInstagramUrl  String?
  contactMapsUrl       String?
  contactAddressLine   String?
  contactBookingMessage String?
  updatedAt     DateTime @updatedAt
}

model Event {
  id        String @id @default(cuid())
  sortOrder Int    @default(0)
  title     String
  dateLabel String
  room      String
  genre     String
  gradient  String
}

model Resident {
  id        String @id @default(cuid())
  sortOrder Int    @default(0)
  name      String
  tags      String
  gradient  String
}

model MenuCategory {
  id        String     @id @default(cuid())
  sortOrder Int        @default(0)
  label     String
  kind      String
  items     MenuItem[]
}

model MenuItem {
  id         String       @id @default(cuid())
  categoryId String
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  sortOrder  Int          @default(0)
  name       String
  price      String
  note       String?
}

model FaqItem {
  id        String @id @default(cuid())
  sortOrder Int    @default(0)
  q         String
  a         String
}

model WeeklySlot {
  id        String @id @default(cuid())
  sortOrder Int    @default(0)
  day       String
  vibe      String
  time      String
}

/// Single-tenant outlet for reservations API (brandId boiler-room).
model Venue {
  id        String @id @default(cuid())
  brandId   String @unique
  name      String
  createdAt DateTime @default(now())
}

model Reservation {
  id                  String   @id @default(cuid())
  createdAt           DateTime @default(now())
  fullName            String
  contactNumber       String
  numberOfMen         Int
  numberOfWomen       Int      @default(0)
  numberOfCouples     Int      @default(0)
  date                String
  timeSlot            String
  session             String
  notes               String?
  selectedDiscounts   Json
  brandId             String
  brandName           String
  hubSpotId           String?
  eventId             String?
  eventName           String?
  status              String   @default("confirmed")
  /// Fingerprint for ~30s double-submit dedupe
  dedupeKey           String?

  @@index([dedupeKey, createdAt])
  @@index([contactNumber, date, timeSlot, createdAt])
}

model GalleryImage {
  id        String @id @default(cuid())
  url       String
  alt       String?
  sortOrder Int    @default(0)
}
